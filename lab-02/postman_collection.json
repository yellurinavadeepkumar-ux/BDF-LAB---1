{
  "info": {
    "_postman_id": "lab-02-sqlite-crud",
    "name": "Lab 2 - SQLite Database and CRUD Routes",
    "description": "Postman API test collection for Lab 2: SQLite Database and CRUD Routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET API Overview",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Retrieve welcome message and available routes."
      },
      "response": []
    },
    {
      "name": "2. GET All Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": ["{{baseUrl}}"],
          "path": ["books", ""]
        },
        "description": "Retrieve all books ordered by ID from the SQLite database."
      },
      "response": []
    },
    {
      "name": "3. GET Book by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1", ""]
        },
        "description": "Retrieve details of a single book with ID = 1."
      },
      "response": []
    },
    {
      "name": "4. GET Nonexistent Book (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/999/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "999", ""]
        },
        "description": "Verify 404 response for a book ID that does not exist."
      },
      "response": []
    },
    {
      "name": "5. POST Add Book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Atomic Habits\",\n  \"author\": \"James Clear\",\n  \"price\": 550,\n  \"pages\": 320\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": ["{{baseUrl}}"],
          "path": ["books", ""]
        },
        "description": "Add a new book record into the SQLite database table."
      },
      "response": []
    },
    {
      "name": "6. PUT Update Book",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Atomic Habits - Special Edition\",\n  \"author\": \"James Clear\",\n  \"price\": 599,\n  \"pages\": 336\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/books/11/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "11", ""]
        },
        "description": "Update an existing book record in the database."
      },
      "response": []
    },
    {
      "name": "7. DELETE Book",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/11/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "11", ""]
        },
        "description": "Delete a book record from the database by ID."
      },
      "response": []
    },
    {
      "name": "8. Verify Deletion (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/11/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "11", ""]
        },
        "description": "Confirm that the deleted book ID 11 returns 404 Not Found."
      },
      "response": []
    }
  ]
}
